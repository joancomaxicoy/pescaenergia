# Aplicació
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
USERS_TIMEZONE=Europe/Madrid

# Base de dades
DATABASE_URL=

# Autenticació. Genereu un valor aleatori de 32 caràcters com a mínim.
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Correu
SERVIDOR_SMTP=
PUERTO_SMTP=587
SMTP_USER=
SMTP_PASSWORD=

# MQTT
MQTT_BROKER_URL=
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=
MQTT_STATIC_TOPICS=

# Seeder d'administradors. Deseu el JSON complet al gestor de secrets.
ADMIN_SEEDER_USERS_JSON=

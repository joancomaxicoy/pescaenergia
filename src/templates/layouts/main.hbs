<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - PescaEnergia</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon.png">
    <meta name="theme-color" content="#1b4444">
    
    {{#if googleClientId}}
    <meta name="google-client-id" content="{{googleClientId}}">
    {{/if}}
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
    {{#if showNavbar}}
        {{> navbar}}
    {{/if}}
    
    <main class="main-content">
        {{{body}}}
    </main>

    {{#if showFooter}}
        <footer class="footer">
            <div class="container">
                <p>&copy; 2025 PescaEnergia. Tots els drets reservats.</p>
            </div>
        </footer>
    {{/if}}

    <!-- Profile Modal (global) -->
    <div id="profileModal" class="modal modal-hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Perfil d'usuari</h3>
                <button class="modal-close" id="closeProfileBtn">&times;</button>
            </div>
            <div class="modal-body">
                <!-- Message container for success/error feedback -->
                <div id="profileMessage" class="profile-message" style="display: none;">
                    <div class="message-content">
                        <i class="message-icon" data-lucide="check-circle"></i>
                        <span class="message-text"></span>
                    </div>
                </div>

                <form id="profileForm">
                    <div class="form-group">
                        <label for="profileName" class="form-label">Nom</label>
                        <input type="text" id="profileName" class="form-input" value="{{user.name}}" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="profileEmail" class="form-label">Correu electrònic</label>
                        <input type="email" id="profileEmail" class="form-input" value="{{user.email}}" disabled>
                        <small class="form-help">El correu electrònic no es pot modificar</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="profileCups" class="form-label">CUPS</label>
                        <input type="text" id="profileCups" class="form-input" value="{{user.cups}}" disabled>
                        <small class="form-help">Contacta amb suport per canviar el CUPS</small>
                    </div>
                    
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <span class="btn-text">Guardar canvis</span>
                            <span class="loading loading-hidden" id="profileLoading"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Módulos comunes (orden importante) -->
    <script src="/js/api-client.js"></script>
    <script src="/js/ui-utils.js"></script>
    <script src="/js/dashboard-base.js"></script>
    <script src="/js/profile.js"></script>
    <script src="/js/auth.js"></script>
    
    {{#if additionalScripts}}
        {{#each additionalScripts}}
            <script src="{{this}}"></script>
        {{/each}}
    {{/if}}
</body>
</html>

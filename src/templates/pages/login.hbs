<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/images/pescaenergia-logo.png" alt="PescaEnergia" class="auth-logo">
            <h1 class="auth-title">Àrea d'Usuari</h1>
            <p class="auth-subtitle">Accedeix al teu compte per gestionar la teva energia</p>
        </div>

        <!-- Alerts -->
        <div id="alert-container"></div>

        <!-- Login Form -->
        <form id="loginForm" class="form-visible">
            <div class="form-group">
                <label for="loginEmail" class="form-label">Correu electrònic</label>
                <input type="email" id="loginEmail" class="form-input" required>
                <div class="form-error" id="loginEmailError"></div>
            </div>

            <div class="form-group">
                <label for="loginPassword" class="form-label">Contrasenya</label>
                <input type="password" id="loginPassword" class="form-input" required>
                <div class="form-error" id="loginPasswordError"></div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="loginBtn">
                <span class="btn-text">Iniciar sessió</span>
                <span class="loading loading-hidden" id="loginLoading"></span>
            </button>

            <div class="auth-links">
                <a href="#" class="auth-link" id="forgotPasswordLink">Has oblidat la contrasenya?</a>
                <br>
                <a href="#" class="auth-link" id="showRegisterLink">No tens compte? Registra't</a>
            </div>
        </form>

        <!-- Register Form -->
        <form id="registerForm" class="form-hidden">
            <div class="form-group">
                <label for="registerName" class="form-label">Nom complet</label>
                <input type="text" id="registerName" class="form-input" required>
                <div class="form-error" id="registerNameError"></div>
            </div>

            <div class="form-group">
                <label for="registerEmail" class="form-label">Correu electrònic</label>
                <input type="email" id="registerEmail" class="form-input" required>
                <div class="form-error" id="registerEmailError"></div>
            </div>

            <div class="form-group">
                <label for="registerPassword" class="form-label">Contrasenya</label>
                <input type="password" id="registerPassword" class="form-input" required>
                <div class="form-error" id="registerPasswordError"></div>
                <div class="form-success" id="registerPasswordSuccess"></div>
            </div>

            <div class="form-group">
                <label for="registerPasswordConfirm" class="form-label">Confirmar contrasenya</label>
                <input type="password" id="registerPasswordConfirm" class="form-input" required>
                <div class="form-error" id="registerPasswordConfirmError"></div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="registerBtn">
                <span class="btn-text">Crear compte</span>
                <span class="loading loading-hidden" id="registerLoading"></span>
            </button>

            <div class="auth-links">
                <a href="#" class="auth-link" id="showLoginLink">Ja tens compte? Inicia sessió</a>
            </div>
        </form>

        <!-- Forgot Password Modal -->
        <div id="forgotPasswordModal" class="modal" style="display: none;">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Recuperar contrasenya</h2>
                    <span class="close" id="closeForgotModal">&times;</span>
                </div>
                <div class="modal-body">
                    <p>Introdueix el teu correu electrònic i t'enviarem un enllaç per restablir la contrasenya.</p>
                    <form id="forgotPasswordForm">
                        <div class="form-group">
                            <label for="forgotEmail" class="form-label">Correu electrònic</label>
                            <input type="email" id="forgotEmail" class="form-input" required>
                            <div class="form-error" id="forgotEmailError"></div>
                        </div>
                        <div class="modal-buttons">
                            <button type="button" class="btn btn-secondary" id="cancelForgotBtn">Cancel·lar</button>
                            <button type="submit" class="btn btn-primary" id="sendResetBtn">
                                <span class="btn-text">Enviar enllaç</span>
                                <span class="loading loading-hidden" id="forgotLoading"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

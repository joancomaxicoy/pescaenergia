<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/images/pescaenergia-logo.png" alt="PescaEnergia" class="auth-logo">
            <h1 class="auth-title">Error de restabliment</h1>
            <p class="auth-subtitle">No s'ha pogut processar la sol·licitud</p>
        </div>

        <div class="alert alert-error">
            {{message}}
        </div>

        <div class="empty-state">
            <div class="empty-state-icon">⚠️</div>
            <h2 class="empty-state-title">Enllaç invàlid</h2>
            <p class="empty-state-description">
                L'enllaç de restabliment de contrasenya pot haver expirat o ser invàlid. 
                Pots sol·licitar un nou enllaç des de la pàgina de login.
            </p>
        </div>

        <div style="text-align: center; margin-top: 30px;">
            <a href="/area-usuari/login" class="btn btn-primary btn-block">
                Anar al login
            </a>
            
            <div style="margin-top: 20px;">
                <p style="color: #666; font-size: 14px;">
                    ¿Necessites ajuda? Contacta amb el nostre suport.
                </p>
            </div>
        </div>
    </div>
</div>

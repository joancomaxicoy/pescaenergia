<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">Endolls</h1>
        <p class="dashboard-subtitle">
            CUPS: <strong>{{user.cups}}</strong> | 
            Últim accés: {{formatDate user.updated_at}}
        </p>
    </div>

    <div class="dashboard-content">
        <!-- Mensaje de resultado -->
        <div id="discoverMessage" class="alert" style="display: none; margin-bottom: 20px;"></div>

        <!-- Piscina -->
        <div id="poolSection" style="display: none;">
            <div id="poolContainer"></div>
        </div>

        <!-- Lista de endolls -->
        <div id="plugsList" style="display: none;">
            <h3 style="color: #1b4444; margin-bottom: 20px;">Els teus endolls</h3>
            <div id="plugsContainer"></div>
        </div>

        <!-- Plugs Chart Section -->
        <div id="plugsChartSection" class="plugs-chart-section" style="display: none;">
            <div class="chart-header">
                <h2 class="chart-title">
                    <i data-lucide="bar-chart-3"></i>
                    Consum per Endolls
                </h2>
                <div class="chart-controls">
                    <button-toggle 
                        id="plugs-period-toggle"
                        modes="24h,7d,30d"
                        mode="0">
                    </button-toggle>
                </div>
            </div>
            <div class="chart-container">
                <div id="plugsChartLoading" class="chart-loading">
                    <div class="loading-spinner"></div>
                    <p>Carregant dades de consum...</p>
                </div>
                <div id="plugsChartError" class="chart-error" style="display: none;">
                    <i data-lucide="alert-circle"></i>
                    <p>Error carregant les dades de consum</p>
                    <button class="btn btn-sm" onclick="loadPlugsChart()">Tornar a intentar</button>
                </div>
                <canvas id="plugsChart" style="display: none;"></canvas>
            </div>
            <div class="chart-legend">
                <div class="legend-item generation">
                    <span class="legend-color"></span>
                    <span class="legend-label">Generació</span>
                </div>
                <div class="legend-item plugs">
                    <span class="legend-color"></span>
                    <span class="legend-label">Endolls</span>
                </div>
                <div class="legend-item other">
                    <span class="legend-color"></span>
                    <span class="legend-label">Resta consum</span>
                </div>
            </div>
        </div>

        <!-- Estado vacío inicial -->
        <div id="emptyState" class="empty-state" style="display: block;">
            <div class="empty-state-icon">
                <i data-lucide="plug"></i>
            </div>
            <h2 class="empty-state-title">Gestió d'Endolls</h2>
            <p class="empty-state-description">
                Busca automàticament endolls intel·ligents associats al teu CUPS.
            </p>
        </div>

        <!-- Botón de descobrir al final -->
        <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
            <button id="discoverBtn" class="btn btn-secondary" style="font-size: 14px; padding: 8px 16px;">
                <span class="btn-text">
                    <i data-lucide="search" style="width: 14px; height: 14px; margin-right: 6px;"></i>
                    Descobrir nous endolls
                </span>
                <span class="loading loading-hidden" id="discoverLoading"></span>
            </button>
        </div>
    </div>
</div>

<!-- Modal de descobriment -->
<div id="discoverModal" class="modal modal-hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Descobriment d'Endolls</h3>
            <button class="modal-close" id="closeDiscoverModal">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="modal-body">
            <!-- Estado de carga -->
            <div id="modalLoading" class="loading-container" style="display: none;">
                <div class="loading-spinner"></div>
                <p>Buscant endolls intel·ligents...</p>
            </div>
            
            <!-- Resultados -->
            <div id="modalResults" style="display: none;">
                <div id="modalMessage" class="alert" style="margin-bottom: 20px;"></div>
                <div id="modalPlugsList"></div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<!-- Scripts específicos de endolls -->
<script src="/js/components/toggle-switch.js"></script>
<script src="/js/components/button-toggle.js"></script>
<script src="/js/components/time-slot-selector.js"></script>
<script src="/js/components/plug-card.js"></script>
<script src="/js/components/pool-card.js?v=2"></script>
<script src="/js/sse-manager.js"></script>
<script src="/js/endolls.js"></script>

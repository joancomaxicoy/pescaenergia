<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/images/pescaenergia-logo.png" alt="PescaEnergia" class="auth-logo">
            <h1 class="auth-title">Establir Contrasenya</h1>
            <p class="auth-subtitle">Per completar el teu registre, estableix una contrasenya definitiva</p>
        </div>

        <form id="setPasswordForm" class="auth-form">
            <div class="form-group">
                <label for="newPassword" class="form-label">Nova Contrasenya</label>
                <input
                    type="password"
                    id="newPassword"
                    name="newPassword"
                    class="form-input"
                    placeholder="Introdueix la nova contrasenya"
                    required
                >
                <div id="newPasswordError" class="form-error"></div>
                <div class="password-requirements">
                    <small>La contrasenya ha de tenir:</small>
                    <ul>
                        <li>Mínim 8 caràcters</li>
                        <li>Almenys una lletra majúscula</li>
                        <li>Almenys una lletra minúscula</li>
                        <li>Almenys un número</li>
                    </ul>
                </div>
            </div>

            <div class="form-group">
                <label for="confirmPassword" class="form-label">Confirmar Contrasenya</label>
                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    class="form-input"
                    placeholder="Confirma la nova contrasenya"
                    required
                >
                <div id="confirmPasswordError" class="form-error"></div>
            </div>

            <div id="alert-container"></div>

            <button type="submit" id="setPasswordBtn" class="btn btn-primary btn-block">
                <span class="btn-text">Establir Contrasenya</span>
                <div id="setPasswordLoading" class="loading-spinner loading-hidden">
                    <div class="spinner"></div>
                </div>
            </button>
        </form>

        <div class="auth-links">
            <a href="/area-usuari/logout" class="auth-link">Tancar sessió</a>
        </div>
    </div>
</div>

<script>
// Get token from URL parameters
const urlParams = new URLSearchParams(window.location.search);
const token = urlParams.get('token');

if (!token) {
    window.location.href = '/area-usuari/login';
}

document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('setPasswordForm');
    const newPasswordInput = document.getElementById('newPassword');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const setPasswordBtn = document.getElementById('setPasswordBtn');
    const setPasswordLoading = document.getElementById('setPasswordLoading');
    const btnText = setPasswordBtn.querySelector('.btn-text');

    // Password validation
    function validatePassword(password) {
        const errors = [];

        if (password.length < 8) {
            errors.push('La contrasenya ha de tenir almenys 8 caràcters');
        }

        if (!/[A-Z]/.test(password)) {
            errors.push('La contrasenya ha de tenir almenys una lletra majúscula');
        }

        if (!/[a-z]/.test(password)) {
            errors.push('La contrasenya ha de tenir almenys una lletra minúscula');
        }

        if (!/[0-9]/.test(password)) {
            errors.push('La contrasenya ha de tenir almenys un número');
        }

        return {
            isValid: errors.length === 0,
            errors: errors
        };
    }

    // Show field error
    function showFieldError(fieldId, message) {
        const errorEl = document.getElementById(fieldId + 'Error');
        const inputEl = document.getElementById(fieldId);

        if (errorEl) errorEl.textContent = message;
        if (inputEl) inputEl.classList.add('error');
    }

    // Clear field error
    function clearFieldError(fieldId) {
        const errorEl = document.getElementById(fieldId + 'Error');
        const inputEl = document.getElementById(fieldId);

        if (errorEl) errorEl.textContent = '';
        if (inputEl) inputEl.classList.remove('error');
    }

    // Clear all errors
    function clearErrors() {
        document.querySelectorAll('.form-error').forEach(el => el.textContent = '');
        document.querySelectorAll('.form-input').forEach(el => el.classList.remove('error'));
        document.getElementById('alert-container').innerHTML = '';
    }

    // Show alert
    function showAlert(type, message) {
        const alertContainer = document.getElementById('alert-container');
        if (alertContainer) {
            alertContainer.innerHTML = `
                <div class="alert alert-${type}">
                    ${message}
                </div>
            `;
        }
    }

    // Form submission
    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const newPassword = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        // Clear previous errors
        clearErrors();

        // Validation
        let hasErrors = false;

        const passwordValidation = validatePassword(newPassword);
        if (!passwordValidation.isValid) {
            showFieldError('newPassword', passwordValidation.errors[0]);
            hasErrors = true;
        }

        if (newPassword !== confirmPassword) {
            showFieldError('confirmPassword', 'Les contrasenyes no coincideixen');
            hasErrors = true;
        }

        if (hasErrors) return;

        // Show loading
        setPasswordBtn.disabled = true;
        btnText.style.display = 'none';
        setPasswordLoading.classList.remove('loading-hidden');

        try {
            const response = await fetch('/api/auth/set-initial-password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    token: token,
                    password: newPassword
                })
            });

            const data = await response.json();

            if (response.ok) {
                showAlert('success', 'Contrasenya establerta correctament! Redirigint...');

                // Store tokens
                if (data.accessToken) {
                    document.cookie = `authToken=${data.accessToken}; path=/; max-age=86400; SameSite=Strict`;
                    localStorage.setItem('authToken', data.accessToken);
                }
                if (data.refreshToken) {
                    document.cookie = `refreshToken=${data.refreshToken}; path=/; max-age=604800; SameSite=Strict`;
                    localStorage.setItem('refreshToken', data.refreshToken);
                }

                // Redirect after success
                setTimeout(() => {
                    // Check if user needs to assign CUPS
                    if (!data.user.cups) {
                        window.location.href = '/area-usuari/assignar-cups';
                    } else {
                        window.location.href = '/area-usuari/dashboard';
                    }
                }, 2000);
            } else {
                showAlert('error', data.error || 'Error establint la contrasenya');
            }
        } catch (error) {
            console.error('Set password error:', error);
            showAlert('error', 'Error de connexió. Torna-ho a intentar.');
        } finally {
            // Hide loading
            setPasswordBtn.disabled = false;
            btnText.style.display = 'inline';
            setPasswordLoading.classList.add('loading-hidden');
        }
    });

    // Real-time validation
    newPasswordInput.addEventListener('input', function() {
        clearFieldError('newPassword');
    });

    confirmPasswordInput.addEventListener('input', function() {
        clearFieldError('confirmPassword');
    });
});
</script>

<style>
.password-requirements {
    margin-top: 8px;
    padding: 12px;
    background-color: #f8f9fa;
    border-radius: 4px;
    border: 1px solid #e9ecef;
}

.password-requirements ul {
    margin: 8px 0 0 0;
    padding-left: 20px;
}

.password-requirements li {
    margin: 4px 0;
    color: #6c757d;
    font-size: 14px;
}

.loading-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
}

.spinner {
    width: 100%;
    height: 100%;
    border: 2px solid #f3f3f3;
    border-top: 2px solid #007bff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.loading-hidden {
    display: none !important;
}
</style>

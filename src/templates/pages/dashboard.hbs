<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">Benvingut, {{user.name}}!</h1>
        <p class="dashboard-subtitle">
            CUPS: <strong>{{user.cups}}</strong> | 
            Últim accés: {{formatDate user.updated_at}}
        </p>
    </div>

    <div class="dashboard-content">
        <!-- Loading state -->
        <div id="dashboardLoading" class="loading-container">
            <div class="loading-spinner"></div>
            <p>Carregant les teves dades energètiques...</p>
        </div>

        <!-- Error state -->
        <div id="dashboardError" class="error-container" style="display: none;">
            <div class="error-icon"><i data-lucide="alert-triangle"></i></div>
            <h3>Error carregant les dades</h3>
            <p id="errorMessage">Hi ha hagut un problema carregant el teu dashboard.</p>
            <button class="btn btn-primary" onclick="loadDashboardData()">Tornar a intentar</button>
        </div>

        <!-- No generators state -->
        <div id="noGenerators" class="empty-state" style="display: none;">
            <div class="empty-state-icon"><i data-lucide="factory"></i></div>
            <h2 class="empty-state-title">Sense generadors</h2>
            <p class="empty-state-description">
                No hi ha generadors d'energia disponibles actualment.
                Contacta amb l'administrador per obtenir més informació.
            </p>
        </div>

        <!-- Generators dashboard -->
        <div id="generatorsDashboard" style="display: none;">
            <!-- Historical Chart Section -->
            <div class="historical-chart-section">
                <div class="chart-header">
                    <h2 class="chart-title">
                        <i data-lucide="trending-up"></i>
                        Històric d'Energia
                    </h2>
                    <div class="chart-controls">
                        <button-toggle 
                            id="period-toggle"
                            modes="24h,7d,30d"
                            mode="0">
                        </button-toggle>
                    </div>
                </div>
                <div class="chart-container">
                    <div id="chartLoading" class="chart-loading">
                        <div class="loading-spinner"></div>
                        <p>Carregant dades històriques...</p>
                    </div>
                    <div id="chartError" class="chart-error" style="display: none;">
                        <i data-lucide="alert-circle"></i>
                        <p>Error carregant les dades històriques</p>
                        <button class="btn btn-sm" onclick="loadHistoricalChart()">Tornar a intentar</button>
                    </div>
                    <canvas id="historicalChart" style="display: none;"></canvas>
                </div>
                <div class="chart-legend">
                    <div class="legend-item consumption">
                        <span class="legend-color"></span>
                        <span class="legend-label">Consum</span>
                    </div>
                    <div class="legend-item generation">
                        <span class="legend-color"></span>
                        <span class="legend-label">Generació</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stats">
                <div class="stat-card">
                    <div class="stat-icon"><i data-lucide="battery-charging"></i></div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalKwUtilized">-</div>
                        <div class="stat-label">kW Aprofitats</div>
                        <div class="stat-description">Total del període actual</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i data-lucide="zap-off"></i></div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalKwWasted">-</div>
                        <div class="stat-label">kW Perduts</div>
                        <div class="stat-description">Total del període actual</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i data-lucide="percent"></i></div>
                    <div class="stat-content">
                        <div class="stat-value" id="utilizationPercentage">-</div>
                        <div class="stat-label">% Aprofitament</div>
                        <div class="stat-description">Eficiència del període actual</div>
                    </div>
                </div>
            </div>

            <!-- Difference Chart Section -->
            <div class="difference-chart-section">
                <div class="chart-header">
                    <h2 class="chart-title">
                        <i data-lucide="bar-chart"></i>
                        Aprofitament Energètic
                    </h2>
                    <div class="chart-controls">
                        <button-toggle 
                            id="difference-period-toggle"
                            modes="24h,7d,30d"
                            mode="0">
                        </button-toggle>
                    </div>
                </div>
                <div class="chart-container">
                    <div id="differenceChartLoading" class="chart-loading">
                        <div class="loading-spinner"></div>
                        <p>Carregant dades d'aprofitament...</p>
                    </div>
                    <div id="differenceChartError" class="chart-error" style="display: none;">
                        <i data-lucide="alert-circle"></i>
                        <p>Error carregant les dades d'aprofitament</p>
                        <button class="btn btn-sm" onclick="loadHistoricalChart()">Tornar a intentar</button>
                    </div>
                    <canvas id="differenceChart" style="display: none;"></canvas>
                </div>
                <div class="chart-legend">
                    <div class="legend-item solar">
                        <span class="legend-color"></span>
                        <span class="legend-label">Energia solar</span>
                    </div>
                    <div class="legend-item grid">
                        <span class="legend-color"></span>
                        <span class="legend-label">Energia de la xarxa</span>
                    </div>
                </div>
            </div>

            

            <div id="generatorsList" class="generators-list">
                <!-- Los generadores se cargarán dinámicamente aquí -->
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<!-- Button Toggle Component -->
<script src="/js/components/button-toggle.js"></script>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">Benvingut, {{user.name}}!</h1>
        <p class="dashboard-subtitle">
            CUPS: <strong>{{user.cups}}</strong> | 
            Últim accés: {{formatDate user.updated_at}}
        </p>
    </div>

    <div class="dashboard-content">
        <!-- Loading state -->
        <div id="dashboardLoading" class="loading-container">
            <div class="loading-spinner"></div>
            <p>Carregant les teves dades energètiques...</p>
        </div>

        <!-- Error state -->
        <div id="dashboardError" class="error-container" style="display: none;">
            <div class="error-icon"><i data-lucide="alert-triangle"></i></div>
            <h3>Error carregant les dades</h3>
            <p id="errorMessage">Hi ha hagut un problema carregant el teu dashboard.</p>
            <button class="btn btn-primary" onclick="loadDashboardData()">Tornar a intentar</button>
        </div>

        <!-- No generators state -->
        <div id="noGenerators" class="empty-state" style="display: none;">
            <div class="empty-state-icon"><i data-lucide="factory"></i></div>
            <h2 class="empty-state-title">Sense generadors</h2>
            <p class="empty-state-description">
                No hi ha generadors d'energia disponibles actualment.
                Contacta amb l'administrador per obtenir més informació.
            </p>
        </div>

        <!-- Generators dashboard -->
        <div id="generatorsDashboard" style="display: none;">
            <!-- Historical Chart Section -->
            <div class="historical-chart-section">
                <div class="chart-header">
                    <h2 class="chart-title">
                        <i data-lucide="trending-up"></i>
                        Històric d'Energia
                    </h2>
                    <div class="chart-controls">
                        <button class="period-btn active" data-period="24h">24h</button>
                        <button class="period-btn" data-period="7d">7d</button>
                        <button class="period-btn" data-period="30d">30d</button>
                    </div>
                </div>
                <div class="chart-container">
                    <div id="chartLoading" class="chart-loading">
                        <div class="loading-spinner"></div>
                        <p>Carregant dades històriques...</p>
                    </div>
                    <div id="chartError" class="chart-error" style="display: none;">
                        <i data-lucide="alert-circle"></i>
                        <p>Error carregant les dades històriques</p>
                        <button class="btn btn-sm" onclick="loadHistoricalChart()">Tornar a intentar</button>
                    </div>
                    <canvas id="historicalChart" style="display: none;"></canvas>
                </div>
                <div class="chart-legend">
                    <div class="legend-item consumption">
                        <span class="legend-color"></span>
                        <span class="legend-label">Consum</span>
                    </div>
                    <div class="legend-item generation">
                        <span class="legend-color"></span>
                        <span class="legend-label">Generació</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stats">
                <div class="stat-card">
                    <div class="stat-icon"><i data-lucide="zap"></i></div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalGenerators">-</div>
                        <div class="stat-label">Generadors</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i data-lucide="bar-chart-3"></i></div>
                    <div class="stat-content">
                        <div class="stat-value" id="totalParticipation">-</div>
                        <div class="stat-label">% Total</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon"><i data-lucide="refresh-cw"></i></div>
                    <div class="stat-content">
                        <div class="stat-value" id="lastUpdate">-</div>
                        <div class="stat-label">Última actualització</div>
                    </div>
                </div>
            </div>

            <div id="generatorsList" class="generators-list">
                <!-- Los generadores se cargarán dinámicamente aquí -->
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

<!-- Profile Modal -->
<div id="profileModal" class="modal modal-hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Perfil d'usuari</h3>
            <button class="modal-close" id="closeProfileBtn">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Message container for success/error feedback -->
            <div id="profileMessage" class="profile-message" style="display: none;">
                <div class="message-content">
                    <i class="message-icon" data-lucide="check-circle"></i>
                    <span class="message-text"></span>
                </div>
            </div>

            <form id="profileForm">
                <div class="form-group">
                    <label for="profileName" class="form-label">Nom</label>
                    <input type="text" id="profileName" class="form-input" value="{{user.name}}" required>
                </div>
                
                <div class="form-group">
                    <label for="profileEmail" class="form-label">Correu electrònic</label>
                    <input type="email" id="profileEmail" class="form-input" value="{{user.email}}" disabled>
                    <small class="form-help">El correu electrònic no es pot modificar</small>
                </div>
                
                <div class="form-group">
                    <label for="profileCups" class="form-label">CUPS</label>
                    <input type="text" id="profileCups" class="form-input" value="{{user.cups}}" disabled>
                    <small class="form-help">Contacta amb suport per canviar el CUPS</small>
                </div>
                
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <span class="btn-text">Guardar canvis</span>
                        <span class="loading loading-hidden" id="profileLoading"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

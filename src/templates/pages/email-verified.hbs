<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="/images/pescaenergia-logo.png" alt="PescaEnergia" class="auth-logo">
            {{#if success}}
                <h1 class="auth-title">Email verificat!</h1>
                <p class="auth-subtitle">El teu compte ha estat activat correctament</p>
            {{else}}
                <h1 class="auth-title">Error de verificació</h1>
                <p class="auth-subtitle">No s'ha pogut verificar el teu email</p>
            {{/if}}
        </div>

        {{#if success}}
            <div class="alert alert-success">
                {{message}}
            </div>

            <div class="empty-state">
                <h2 class="empty-state-title">Verificació completada</h2>
                <p class="empty-state-description">
                    Ja pots accedir al teu compte i començar a gestionar la teva energia.
                </p>
            </div>

            <div style="text-align: center; margin-top: 30px;">
                <a href="/area-usuari/login" class="btn btn-primary btn-block">
                    Iniciar sessió
                </a>
            </div>
        {{else}}
            <div class="alert alert-error">
                {{message}}
            </div>

            <div class="empty-state">
                <h2 class="empty-state-title">Verificació fallida</h2>
                <p class="empty-state-description">
                    L'enllaç de verificació pot haver expirat o ser invàlid. 
                    Pots sol·licitar un nou enllaç des de la pàgina de login.
                </p>
            </div>

            <div style="text-align: center; margin-top: 30px;">
                <a href="/area-usuari/login" class="btn btn-primary btn-block">
                    Anar al login
                </a>
            </div>
        {{/if}}
    </div>
</div>

{{#if success}}
{{#if accessToken}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-login with tokens from verification
    const accessToken = '{{{accessToken}}}';
    const refreshToken = '{{{refreshToken}}}';
    const user = JSON.parse('{{{userJson}}}');

    if (accessToken && user) {
        // Store tokens
        document.cookie = `authToken=${accessToken}; path=/; max-age=86400; SameSite=Strict`;
        localStorage.setItem('authToken', accessToken);
        
        if (refreshToken) {
            document.cookie = `refreshToken=${refreshToken}; path=/; max-age=604800; SameSite=Strict`;
            localStorage.setItem('refreshToken', refreshToken);
        }

        // Redirect based on user state
        setTimeout(() => {
            // Check if user needs to set initial password
            if (user.is_temp_password) {
                window.location.href = '/area-usuari/set-initial-password';
                return;
            }

            // Check if user needs to assign CUPS
            if (!user.cups) {
                window.location.href = '/area-usuari/assignar-cups';
            } else {
                window.location.href = '/area-usuari/dashboard';
            }
        }, 2000);
    }
});
</script>
{{/if}}
{{/if}}
